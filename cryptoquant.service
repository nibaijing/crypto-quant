[Unit]
Description=CryptoQuant Live Trading Simulator
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ni/crypto_quant
ExecStart=/usr/bin/python3 /home/ni/crypto_quant/run_live.py
Restart=always
RestartSec=15
StandardOutput=append:/home/ni/crypto_quant/data/live_trading.log
StandardError=append:/home/ni/crypto_quant/data/live_trading.log

[Install]
WantedBy=default.target